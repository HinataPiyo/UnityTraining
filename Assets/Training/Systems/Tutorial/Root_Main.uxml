    <ui:VisualElement name="root" style="flex-grow: 1;">
        <ui:VisualElement name="buttons" style="flex-grow: 1; background-color: rgb(194, 252, 255);">
            <ui:Button text="1" name="Button1" class="button tutorial" style="position: absolute; height: 144px; width: 239px; right: 24px; top: 37px;"/>
            <ui:Button text="2" name="Button2" class="button tutorial" style="position: absolute; bottom: 0; left: 115px; height: 265px; width: 420px;"/>
            <ui:Button text="3" name="Button3" class="button tutorial" style="position: absolute; bottom: 0; left: 708px; height: 265px; width: 420px;"/>
            <ui:Button text="4" name="Button4" class="button tutorial" style="position: absolute; height: 393px; width: 427px; right: 141px; bottom: 168px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="focus" style="position: absolute; width: 100%; height: 100%; display: none;">
            <ui:VisualElement name="background" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.6);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
